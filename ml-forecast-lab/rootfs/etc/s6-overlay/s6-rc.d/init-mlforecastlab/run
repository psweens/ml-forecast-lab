#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# ML Forecast Lab - Init and run script
# ==============================================================================

bashio::log.info "Initialising ML Forecast Lab environment..."

mkdir -p /data/ml_forecast_lab
mkdir -p /data/ml_forecast_lab/models
mkdir -p /data/ml_forecast_lab/logs

# Find the addon_configs directory (HA maps it with a slug hash prefix).
#
# HA's slug hash is always 8 lowercase hex characters followed by an
# underscore — anchor the glob to that shape so a community fork with a
# slug like `psweens_ml_forecast_lab` (which would also match the loose
# `*_ml_forecast_lab` pattern) can't capture our config search.
ADDON_CONFIG=""
candidate_dirs=("/addon_configs/ml_forecast_lab")
for d in /addon_configs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]_ml_forecast_lab; do
    [ -d "$d" ] && candidate_dirs+=("$d")
done
candidate_dirs+=("/config")

for dir in "${candidate_dirs[@]}"; do
    if [ -d "$dir" ]; then
        ADDON_CONFIG="$dir"
        break
    fi
done

bashio::log.info "Addon config directory: ${ADDON_CONFIG}"

# Copy default config if none exists yet
if [ -n "$ADDON_CONFIG" ] && [ ! -f "${ADDON_CONFIG}/mlfl.yaml" ]; then
    if [ -f /app/mlfl.yaml ]; then
        cp /app/mlfl.yaml "${ADDON_CONFIG}/mlfl.yaml"
        bashio::log.info "Copied default mlfl.yaml to ${ADDON_CONFIG}/"
    fi
fi

# ---------------------------------------------------------------------------
# Developer-mode branch overlay (maintainer aid; default OFF).
#
# When the `developer_mode` add-on option is enabled AND a branch overlay
# has been installed from the System-tab Developer card, run that branch
# in place of the bundled package by prepending the overlay to PYTHONPATH
# so its `ml_forecast_lab` shadows /app/ml_forecast_lab. The bundled image
# is never modified: turning developer_mode off (or deleting the overlay)
# falls straight back to /app on the next restart. See
# ml_forecast_lab/dev_branch.py for the full contract.
#
# DEVELOPER_MODE is also exported so the running app can gate the card and
# its endpoints, mirroring how the base image surfaces LOG_LEVEL.
# ---------------------------------------------------------------------------
DEV_MODE="$(bashio::config 'developer_mode' 'false')"
export DEVELOPER_MODE="${DEV_MODE}"
DEV_SRC="/data/ml_forecast_lab/dev_src"
if [ "${DEV_MODE}" = "true" ] \
    && [ -f "${DEV_SRC}/ACTIVE.json" ] \
    && [ -d "${DEV_SRC}/ml_forecast_lab" ]; then
    bashio::log.warning "DEVELOPER MODE: running overlaid branch from ${DEV_SRC}"
    bashio::log.warning "  -> this is NOT the bundled release; revert from the System tab."
    export PYTHONPATH="${DEV_SRC}:${PYTHONPATH}"
fi

bashio::log.info "Starting ML Forecast Lab service..."
exec python3 -m ml_forecast_lab
