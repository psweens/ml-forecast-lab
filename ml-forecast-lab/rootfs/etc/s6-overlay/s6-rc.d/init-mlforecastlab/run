#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# ML Forecast Lab - Init and run script
# ==============================================================================

bashio::log.info "Initialising ML Forecast Lab environment..."

mkdir -p /data/ml_forecast_lab
mkdir -p /data/ml_forecast_lab/models
mkdir -p /data/ml_forecast_lab/logs

# Find the addon_configs directory (HA maps it with a slug hash prefix).
#
# HA's slug hash is always 8 lowercase hex characters followed by an
# underscore — anchor the glob to that shape so a community fork with a
# slug like `psweens_ml_forecast_lab` (which would also match the loose
# `*_ml_forecast_lab` pattern) can't capture our config search.
ADDON_CONFIG=""
candidate_dirs=("/addon_configs/ml_forecast_lab")
for d in /addon_configs/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]_ml_forecast_lab; do
    [ -d "$d" ] && candidate_dirs+=("$d")
done
candidate_dirs+=("/config")

for dir in "${candidate_dirs[@]}"; do
    if [ -d "$dir" ]; then
        ADDON_CONFIG="$dir"
        break
    fi
done

bashio::log.info "Addon config directory: ${ADDON_CONFIG}"

# Copy default config if none exists yet
if [ -n "$ADDON_CONFIG" ] && [ ! -f "${ADDON_CONFIG}/mlfl.yaml" ]; then
    if [ -f /app/mlfl.yaml ]; then
        cp /app/mlfl.yaml "${ADDON_CONFIG}/mlfl.yaml"
        bashio::log.info "Copied default mlfl.yaml to ${ADDON_CONFIG}/"
    fi
fi

bashio::log.info "Starting ML Forecast Lab service..."
exec python3 -m ml_forecast_lab
